<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-tar">
    <comment>TAR archive</comment>
    <glob pattern="*.tar"/>
  </mime-type>
  <mime-type type="application/x-gtar">
    <comment>GNU TAR archive</comment>
    <glob pattern="*.gtar"/>
  </mime-type>
  <mime-type type="application/gzip">
    <comment>Gzip compressed TAR</comment>
    <glob pattern="*.tgz"/>
    <glob pattern="*.tar.gz"/>
  </mime-type>
  <mime-type type="application/x-bzip2">
    <comment>Bzip2 compressed TAR</comment>
    <glob pattern="*.tbz"/>
    <glob pattern="*.tbz2"/>
    <glob pattern="*.tar.bz2"/>
  </mime-type>
  <mime-type type="application/x-xz">
    <comment>XZ compressed TAR</comment>
    <glob pattern="*.txz"/>
    <glob pattern="*.tar.xz"/>
  </mime-type>
  <mime-type type="application/zstd">
    <comment>Zstandard compressed TAR</comment>
    <glob pattern="*.tzst"/>
    <glob pattern="*.tar.zst"/>
  </mime-type>
  <mime-type type="application/zip">
    <comment>ZIP archive</comment>
    <glob pattern="*.zip"/>
  </mime-type>
  <mime-type type="application/x-7z-compressed">
    <comment>7-Zip archive</comment>
    <glob pattern="*.7z"/>
  </mime-type>
  <mime-type type="application/vnd.rar">
    <comment>RAR archive</comment>
    <glob pattern="*.rar"/>
  </mime-type>
  <mime-type type="application/x-iso9660-image">
    <comment>ISO 9660 image</comment>
    <glob pattern="*.iso"/>
  </mime-type>
</mime-info>
